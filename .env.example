# Copy to .env and adjust. Used by docker compose (--env-file .env) and scripts/hasura-metadata-apply.sh.
# POSTGRES_PASSWORD must match:
#   - the callisto role (scripts/setup-db.sh / reset-db.sh)
#   - .callisto/config.yaml → database.url
POSTGRES_USER=callisto
POSTGRES_PASSWORD=password
POSTGRES_DB=callisto

HASURA_GRAPHQL_ADMIN_SECRET=changeme
