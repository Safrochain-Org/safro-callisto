# Postgres (Callisto + Hasura). Copy to .env and adjust.
POSTGRES_USER=callisto
POSTGRES_PASSWORD=password
POSTGRES_DB=callisto
POSTGRES_HOST=127.0.0.1
# Must match docker-compose postgres publish (default in repo: 5434). Do not use 5432 if Homebrew Postgres owns it.
POSTGRES_PORT=5434

# Optional. Defaults to POSTGRES_USER — correct for Docker postgres image.
# Use only for a local Postgres cluster where the superuser is literally "postgres":
# PG_SUPERUSER=postgres
# PGPASSWORD=...

# Hasura Actions → Callisto on host (must match .callisto/config.yaml actions host:port)
ACTION_BASE_URL=http://host.docker.internal:3001

# Optional — only if you set HASURA_GRAPHQL_ADMIN_SECRET in docker-compose.yml
# HASURA_GRAPHQL_ADMIN_SECRET=your-secret
