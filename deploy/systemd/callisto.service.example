# /etc/systemd/system/callisto.service
# Callisto indexer binary (runs on host, talks to local Postgres and remote chain RPC).
#
# sudo install -o root -g root -m 644 callisto.service /etc/systemd/system/
# sudo systemctl daemon-reload
# sudo systemctl enable --now callisto.service
#
# Ensure .callisto/config.yaml database URL matches Docker Postgres (127.0.0.1:5434).

[Unit]
Description=Safro Callisto chain indexer
Documentation=file:///opt/safro-callisto/docs/DEPLOY-SERVER.md
After=safro-indexer-docker.service network-online.target
Wants=safro-indexer-docker.service
Wants=network-online.target

[Service]
User=deploy
Group=deploy
WorkingDirectory=/opt/safro-callisto
EnvironmentFile=-/opt/safro-callisto/.env
ExecStart=/opt/safro-callisto/build/callisto start --home /opt/safro-callisto/.callisto
Restart=on-failure
RestartSec=15
# Hardening (adjust if Callisto needs more)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
