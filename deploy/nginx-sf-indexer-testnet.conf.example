# Nginx — expose Hasura GraphQL (and optional health) at sf-indexer-testnet.safrochain.com
# Copy to /etc/nginx/sites-available/ and enable after certbot TLS.
#
# Prerequisites:
#   - Hasura listens on 127.0.0.1:8080 (use deploy/docker-compose.production.yml)
#   - DNS A/AAAA: sf-indexer-testnet.safrochain.com → this server
#
# sudo certbot certonly --nginx -d sf-indexer-testnet.safrochain.com
# Then uncomment the ssl_* lines or use certbot's suggested block.

# Redirect HTTP → HTTPS (after certificates exist)
# server {
#     listen 80;
#     listen [::]:80;
#     server_name sf-indexer-testnet.safrochain.com;
#     return 301 https://$host$request_uri;
# }

server {
    listen 80;
    listen [::]:80;
    server_name sf-indexer-testnet.safrochain.com;

    # After TLS:
    # listen 443 ssl http2;
    # listen [::]:443 ssl http2;
    # ssl_certificate     /etc/letsencrypt/live/sf-indexer-testnet.safrochain.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/sf-indexer-testnet.safrochain.com/privkey.pem;
    # include /etc/letsencrypt/options-ssl-nginx.conf;
    # ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Optional: basic rate limit zone in http {} — limit_req_zone $binary_remote_addr zone=hasura:10m rate=20r/s;
    # limit_req zone=hasura burst=50 nodelay;

    location /healthz {
        proxy_pass http://127.0.0.1:8080/healthz;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # GraphQL API (Big Dipper / clients)
    location /v1/graphql {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # WebSocket subscriptions
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400;
    }

    # Optional: v1/version for ops (or restrict by IP / remove in hardening)
    location /v1/version {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Do NOT expose /v1/console in production unless behind VPN + auth.
}
