# Postgres (Callisto + Hasura) — matches Docker postgres + Hasura from docker compose
POSTGRES_USER=callisto
POSTGRES_PASSWORD=password
POSTGRES_DB=callisto
POSTGRES_HOST=127.0.0.1
# Host port published by docker-compose postgres (127.0.0.1:5434 -> container 5432). Not Homebrew Postgres on 5432.
POSTGRES_PORT=5434

# Same as POSTGRES_USER for official postgres Docker image (superuser). Omit to use default.
PG_SUPERUSER=callisto

HASURA_GRAPHQL_ADMIN_SECRET=rootroottest

# Callisto actions HTTP server on host (see .callisto/config.yaml actions); Hasura container uses this URL.
ACTION_BASE_URL=http://host.docker.internal:3001
